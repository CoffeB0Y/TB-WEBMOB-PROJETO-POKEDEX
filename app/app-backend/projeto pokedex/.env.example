# Copie para .env e preencha localmente. Não versione credenciais.
DATABASE_URL=file:./dev.db
JWT_SECRET=
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

# Gmail SMTP: 465/TLS ou 587/STARTTLS (SMTP_SECURE=false).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Senha de app autorizada para a conta do projeto; não use a senha comum da conta.
SMTP_PASS=
# Endereço Gmail do projeto (ou remetente autorizado nessa conta).
SMTP_FROM=
# URL fixa da interface; em produção use HTTPS.
PASSWORD_RESET_URL=http://localhost:3001/redefinir-senha
